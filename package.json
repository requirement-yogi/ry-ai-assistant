{
  "name": "ry-ai-assistant",
  "version": "0.2.0-beta",
  "description": "MCP server to create and edit Confluence pages with Requirement Yogi macros from an LLM.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ry-ai-assistant": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm",
    "build:dev": "npm run bundle -- --define:process.env.RY_ENV='\"dev\"' --outfile=standalone/ry-ai-assistant-dev.mjs",
    "build:prod": "npm run bundle -- --define:process.env.RY_ENV='\"prod\"' --outfile=standalone/ry-ai-assistant.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "requirement-yogi",
    "confluence",
    "requirements"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
