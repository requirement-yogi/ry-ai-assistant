# Per-developer values for the DEV bundle, baked at build time by `npm run build:dev`
# (scripts/build-bundle.mjs). Copy this file to .env.dev (git-ignored) and fill in YOUR values.
# These are unique per developer, which is why they are not committed.
#
# The prod bundle needs none of this — its values are fixed constants in the source.

# Your personal Forge dev environment id.
RY_DEV_FORGE_ENV_ID=

# Your personal Confluence dev instance base URL.
RY_DEV_CONFLUENCE_URL=https://localhost:8080

# Your standalone API base URL.
RY_DEV_STANDALONE_URL=http://localhost:8082/api
