# Per-developer values for the DEV bundle, baked at build time by `npm run build:dev`
# (scripts/build-bundle.mjs). Copy this file to .env.dev (git-ignored) and fill in YOUR values.
# These are unique per developer, which is why they are not committed.
#
# The prod bundle needs none of this — its values are fixed constants in the source.

# Your personal Forge dev environment id (the middle UUID of the requirement-yogi extension key,
# application_id/ENVIRONMENT_ID/static/requirement-yogi). Required.
RY_DEV_FORGE_ENV_ID=

# Your personal Confluence dev instance base URL (your own tunnel). Required.
RY_DEV_CONFLUENCE_URL=https://<your-tunnel>.websites.requirementyogi.com

# Your standalone API base URL. Optional — defaults to http://localhost:8082/api if omitted.
#RY_DEV_STANDALONE_URL=http://localhost:8082/api
